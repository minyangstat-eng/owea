% Generated by hand to match R/compound.R (this package's man pages are
% maintained by hand, like NAMESPACE).
\name{compound_design}
\alias{compound_design}
\alias{print.compound_design}
\title{Compound (multi-criterion, multi-model) optimal design}
\usage{
compound_design(components, alpha = NULL,
                design_box = NULL, step_sequence = NULL,
                candidate_set = NULL, factor_levels = NULL,
                efficiency = TRUE, psi_star = NULL,
                xi0_points = NULL, xi0_weights = numeric(0),
                n0 = 0, n1 = 1,
                max_iter = 100L, eps0 = 1e-6,
                accept_tol = 1e-9, verbose = FALSE)

\method{print}{compound_design}(x, ...)
}
\arguments{
\item{components}{a list of components, one per criterion. Each element is
itself a list holding the model exactly as \code{\link{optimal_design}} takes
it --- \code{info_vector} or \code{info_matrix} plus \code{theta}, OR a
formula-style spec (\code{link}, \code{f}, \code{x}, \code{fx}, \code{xx},
\code{ff}, \code{intercept}, \code{coding}, \code{ncat}) --- plus \code{p}
(0 = D, 1 = A; default 0), optionally one of \code{subset} / \code{grad_g} /
\code{wb} for the quantity of interest, and optionally a \code{name} used in
the printout. Different components may use entirely different models, with
different numbers of parameters.}

\item{alpha}{nonnegative component weights, recycled to
\code{length(components)} and normalised to sum to 1. Default: equal weights.}

\item{design_box, step_sequence}{continuous design region and grid steps, as in
\code{\link{optimal_design}}. Supply these OR \code{candidate_set}.}

\item{candidate_set}{optional \eqn{n \times d} matrix of candidate points.}

\item{factor_levels}{factor specification for the \code{candidate_set} path.}

\item{efficiency}{if \code{TRUE} (default) each component is divided by its own
optimum \eqn{\Psi_j^{*}}, so \code{alpha} weights efficiencies; if
\code{FALSE} the raw \eqn{\Psi_j} are weighted.}

\item{psi_star}{optional numeric vector of reference values \eqn{\Psi_j^{*}};
by default computed by \code{length(components)} single-component runs over the
same design space.}

\item{xi0_points, xi0_weights, n0, n1}{an existing design to augment, as in
\code{\link{optimal_design}}. The runs are shared by all components; the
information each model extracts from them is not.}

\item{max_iter}{maximum exchange iterations.}

\item{eps0}{stopping threshold on the compound sensitivity function.}

\item{accept_tol}{a refinement stage is kept only if it converges and does not
lose more than this in \eqn{\Psi_\alpha}.}

\item{verbose}{print progress.}

\item{x}{a \code{"compound_design"} result.}

\item{...}{ignored.}
}
\value{
A list of class \code{"compound_design"} with \code{support}, \code{weights},
\code{criterion} (the compound value \eqn{\Psi_\alpha}), \code{max_d} (maximum
compound sensitivity; \eqn{\le} \code{eps0} certifies optimality),
\code{converged}, \code{psi} (per-component \eqn{\Psi_j}), \code{psi_star},
\code{component_criterion} and \code{component_criterion_star} (the
per-component values of this design and of each component's own optimum on
the scale \code{\link{optimal_design}} reports: \eqn{\log\det \Sigma_j / v_j}
for D, \eqn{\mathrm{tr}\,\Sigma_j / v_j} for A, i.e. \eqn{-\log\Psi_j} and
\eqn{1/\Psi_j}; smaller is better),
\code{efficiency} (per-component \eqn{\Psi_j/\Psi_j^{*}}), \code{alpha},
\code{at} (the weights actually used), \code{cross_efficiency},
\code{reference_designs}, \code{information} (a list of the per-component
information matrices \eqn{M_j}), \code{iterations}, \code{times},
\code{grid_sizes} and \code{total_time}.

\code{cross_efficiency} is an \eqn{(J+1) \times J} matrix scoring every design
under every component: row \eqn{j} is the design optimal for component \eqn{j}
alone, the last row (\code{"THIS DESIGN"}) is the compound design, and the
entries are efficiencies \eqn{\Psi_l(\xi)/\Psi_l^{*}}. Its diagonal is 1 by
construction. It shows directly what a single-component design costs under the
other components, and is printed by default. \code{reference_designs} holds
the single-component optimal designs it was built from. Both are \code{NULL}
when no reference solves were run --- that is, when \code{efficiency = FALSE}
or \code{psi_star} was supplied.
}
\description{
Finds one approximate design that is good simultaneously for several criteria,
each of which may belong to a \emph{different model}. The components share the
design region and the design; everything else --- the model, the parameter
dimension, the quantity of interest, the criterion type --- is
component-specific.
}
\details{
The criterion maximised is
\deqn{\Psi_\alpha(\xi)=\sum_j \alpha_j \Psi_j(\xi)/\Psi_j^{*},}
the weighted average of the component \emph{efficiencies}, where
\eqn{\Psi_j^{*}} is the value attained by the design optimal for component
\eqn{j} alone. Each component criterion is stated per parameter,
\deqn{\Psi_j=\det(S_j^{-1})^{1/v_j}\ (p=0,\ D),\qquad
      \Psi_j=v_j/\mathrm{tr}(S_j)\ (p=1,\ A),\qquad
      S_j=G_j M_j^{-1} G_j',}
with \eqn{M_j = a M_{0,j} + b M_{\xi,j}}, \eqn{a=n_0/(n_0+n_1)},
\eqn{b=n_1/(n_0+n_1)}. Both forms are positively homogeneous of degree one in
\eqn{M_j} and equal 1 at \eqn{S_j=I}, so components of different dimension are
comparable and \eqn{\Psi_\alpha} lies in \eqn{(0,1]} and reads directly as an
average efficiency.

\strong{Why efficiency weighting.} The raw \eqn{\Psi_j} of different models are
not comparable --- a logistic model with \eqn{k=3} and a Poisson model with
\eqn{k=4} produce criterion values on unrelated scales --- so with
\code{efficiency = FALSE} the \code{alpha} absorb that mismatch instead of
expressing a preference. The two settings give different optima unless all
\eqn{\Psi_j^{*}} coincide.

\strong{Reference values.} Each \eqn{\Psi_j^{*}} is itself an optimal design
problem, solved here over the same design space and with the same
\code{n0}/\code{n1}/\code{xi0_points}, which is what keeps every efficiency in
\eqn{(0,1]}. They are returned in \code{psi_star} and should be reported with
the design, since they determine the effective weights. A reference solve that
fails to converge is warned about: the design is still a valid optimum, but for
weights other than the ones intended.

\strong{Optimality.} \eqn{\Psi_\alpha} is concave, so the returned design is a
global optimum when \code{max_d} \eqn{\le} \code{eps0}, by the compound
equivalence theorem: writing \eqn{K_j = \alpha_j \Psi_j^{-1*} c_j P_j} with
\eqn{P_j = T_j'S_j^{-1}T_j} (D) or \eqn{T_j'T_j} (A), \eqn{T_j=G_j M_j^{-1}},
\eqn{c_j=\Psi_j/v_j} (D) or \eqn{\Psi_j^2/v_j} (A), the design is optimal iff
\deqn{\sum_j \left[ b\,\mathrm{tr}(K_j I_j(x)) + a\,\mathrm{tr}(K_j M_{0,j})
      \right] \le \Psi_\alpha \quad \textrm{for all } x,}
with equality on the support. Note the optimal information matrices are
unique but the design attaining them need not be, so two runs may return
different supports with the same \eqn{\Psi_\alpha}.
}
\examples{
\dontrun{
# one design for two models at once
f1 <- function(x, th) { q <- c(1, x[1], x[2]); e <- sum(q * th)
                        (exp(e / 2) / (1 + exp(e))) * q }
f2 <- function(x, th) { q <- c(1, x[1], x[2], x[1] * x[2]); e <- sum(q * th)
                        (exp(e / 2) / (1 + exp(e))) * q }
res <- compound_design(
  components = list(list(info_vector = f1, theta = c(0.5, 1, -1), p = 0),
                    list(info_vector = f2, theta = c(0.5, 1, -1, 0.5), p = 0)),
  alpha      = c(0.5, 0.5),
  design_box = list(c(-2, 2), c(-2, 2)),
  step_sequence = c(0.5, 0.1))
print(res)
res$efficiency
}
}
\seealso{
\code{\link{optimal_design}}, \code{\link{compound_sensitivity}}.
}

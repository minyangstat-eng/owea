% Generated by hand to match R/compound_exact.R.
\name{compound_exact_design}
\alias{compound_exact_design}
\alias{print.compound_exact_design}
\title{Exact (integer-run) compound optimal design}
\usage{
compound_exact_design(n, components, alpha = NULL,
                      design_box = NULL, step_sequence = NULL,
                      candidate_set = NULL, factor_levels = NULL,
                      efficiency = TRUE, psi_star = NULL,
                      xi0_points = NULL, xi0_weights = numeric(0),
                      n0 = 0, n1 = 1,
                      max_exchange = 1000L, seed = NULL, snap_support = TRUE,
                      max_iter = 100L, eps0 = 1e-6, accept_tol = 1e-9,
                      verbose = FALSE)

\method{print}{compound_exact_design}(x, ...)
}
\arguments{
\item{n}{integer sample size --- the number of runs to allocate.}

\item{components, alpha, efficiency, psi_star}{the compound criterion, exactly
as in \code{\link{compound_design}}.}

\item{design_box, step_sequence, candidate_set, factor_levels}{the design
region, as in \code{\link{compound_design}}.}

\item{xi0_points, xi0_weights, n0, n1}{an existing design to augment. When an
existing design is given and \code{n1} is not set explicitly it defaults to
\code{n}, so the design is optimised for the balance actually realised.}

\item{max_exchange}{number of random exchanges attempted (default 1000).}

\item{seed}{optional integer seed, for reproducibility.}

\item{snap_support}{for the \code{design_box} path: if \code{TRUE} (default)
the approximate support is snapped to the finest grid; if \code{FALSE} the
off-grid support points are appended to the candidate set.}

\item{max_iter, eps0, accept_tol, verbose}{passed to the internal
\code{\link{compound_design}} call for the approximate reference.}

\item{x}{a \code{"compound_exact_design"} result.}

\item{...}{ignored.}
}
\value{
A list of class \code{"compound_exact_design"} with \code{support},
\code{counts} (integers summing to \code{n}), \code{weights}
(\code{counts / n}), \code{criterion}, \code{criterion_approx},
\code{efficiency_exact} (their ratio, in \eqn{(0,1]}), \code{psi},
\code{psi_star}, \code{component_criterion} and
\code{component_criterion_star} (the per-component values on the scale
\code{\link{optimal_design}} reports, see \code{\link{compound_design}}),
\code{efficiency}, \code{cross_efficiency}, \code{alpha},
\code{at}, \code{information}, \code{n}, \code{exchanges},
\code{n_candidates} (the size of the candidate set the exchanges searched)
and \code{approx} (the full approximate result).
}
\description{
The exact-design counterpart of \code{\link{compound_design}}: allocates a
fixed number of runs \code{n} over design points so that the compound
criterion \eqn{\Psi_\alpha} is as large as possible.
}
\details{
The construction follows \code{\link{exact_design}}: compute the approximate
compound optimum, round its weights to integer counts by largest-remainder
apportionment, repair the total to exactly \code{n} using the compound
sensitivity function, then improve by random exchanges. The one structural
difference is direction --- \eqn{\Psi_\alpha} is maximised, whereas
\eqn{\Phi_p} is minimised --- so the acceptance test is reversed and the
efficiency is \eqn{\Psi_\alpha(\textrm{exact}) /
\Psi_\alpha(\textrm{approximate})}.

The reported \code{efficiency_exact} is a LOWER bound: it compares against the
approximate optimum, which is at least as good as any exact design, so the true
efficiency is at least this value.

With a multistage \code{step_sequence} the exchange step searches a \emph{coarse}
grid over the whole box (the coarsest step in the sequence) together with a
\emph{fine} neighbourhood of the approximate support at the finest step --- the
same candidate set \code{\link{exact_design}} builds. The finest grid is never
materialised over the whole region, whose size grows as the reciprocal of the
final step raised to the number of continuous covariates. A single-step
\code{step_sequence} is unaffected: coarse and fine coincide and the candidate
set is the full grid, as before. Supply \code{candidate_set} to control the
points exactly.
}
\examples{
\dontrun{
f1 <- function(x, th) { q <- c(1, x[1]); e <- sum(q * th)
                        (exp(e / 2) / (1 + exp(e))) * q }
f2 <- function(x, th) { q <- c(1, x[1], x[1]^2); e <- sum(q * th)
                        (exp(e / 2) / (1 + exp(e))) * q }
r <- compound_exact_design(
  n = 30,
  components = list(list(info_vector = f1, theta = c(0.5, 1), p = 0),
                    list(info_vector = f2, theta = c(0.5, 1, -0.5), p = 0)),
  design_box = list(c(-2, 2)), step_sequence = c(0.5, 0.1), seed = 1)
print(r)
r$counts
r$efficiency_exact
}
}
\seealso{
\code{\link{compound_design}}, \code{\link{compound_criterion}},
\code{\link{exact_design}}.
}
